# Copy to .env and replace all four secret values with independent random secrets.
DELTA_TOKEN=
POSTGRES_PASSWORD=
CORE_DB_PASSWORD=
TASKS_DB_PASSWORD=
LLM_PROVIDER=mock
OPENROUTER_API_KEY=
# Legacy fallback when the two role-specific settings are empty:
OPENROUTER_MODEL=
# Select a low-latency tool-capable model for direct commands.
DELTA_ROUTER_MODEL=
DELTA_ASSISTANT_MODEL=
DELTA_ROUTER_MAX_TOKENS=512
DELTA_LOCAL_INTENT_THRESHOLD=0.9
STT_PROVIDER=whisper
WHISPER_MODEL=small
WHISPER_LANGUAGE=ru
VOICE_MAX_SECONDS=60
# Only for explicit STT_PROVIDER=mock, never used as a fallback:
MOCK_STT_TRANSCRIPT=покажи устройства
TTS_PROVIDER=piper
# Docker default: /models/piper/ru_RU-irina-medium.onnx; local Python: set a local path.
PIPER_MODEL=
TTS_MAX_CHARS=1500
TTS_MAX_SECONDS=60
TTS_TIMEOUT_SECONDS=10
# Optional JSON array; omit to discover Delta Tasks using TASKS_URL.
# SERVICE_CONFIGS=[{"service_id":"delta-tasks","base_url":"http://delta-tasks:8000","enabled":true}]

# Control Center host port (change when 8080 is occupied)
DELTA_UI_PORT=8080

# Optional server-local natural voices (Linux CPU; see docs/NEURAL_VOICE.md).
INSTALL_NEURAL=false
QWEN_TTS_DEVICE=cpu
QWEN_TTS_SPEAKER=serena
QWEN_TTS_THREADS=4
QWEN_TTS_TIMEOUT_SECONDS=20
# Named volume by default; alternatively an absolute model directory.
QWEN_MODEL_VOLUME=qwen-models
QWEN_TTS_PREVIEW_TIMEOUT_SECONDS=120
